{"number":105,"name":"سُورَةُ الفِيلِ","englishName":"Al-Fil","englishNameTranslation":"The Elephant","urduName":"ہاتھی / سورۃ الفیل","numberOfAyahs":5,"revelationType":"Meccan","juzStart":30,"ayahs":[{"numberInSurah":1,"globalNumber":6189,"arabicText":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","urduText":"کیا تم نے نہیں دیکھا کہ تمہارے پروردگار نے ہاتھی والوں کے ساتھ کیا کیا","juz":30,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"numberInSurah":2,"globalNumber":6190,"arabicText":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ","urduText":"کیا ان کا داؤں غلط نہیں کیا؟ (گیا)","juz":30,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"numberInSurah":3,"globalNumber":6191,"arabicText":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","urduText":"اور ان پر جھلڑ کے جھلڑ جانور بھیجے","juz":30,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"numberInSurah":4,"globalNumber":6192,"arabicText":"تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ","urduText":"جو ان پر کھنگر کی پتھریاں پھینکتے تھے","juz":30,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"numberInSurah":5,"globalNumber":6193,"arabicText":"فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ","urduText":"تو ان کو ایسا کر دیا جیسے کھایا ہوا بھس","juz":30,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false}]}