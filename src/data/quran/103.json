{"number":103,"name":"سُورَةُ العَصۡرِ","englishName":"Al-Asr","englishNameTranslation":"The Declining Day, Epoch","urduName":"زمانہ / سورۃ العصر","numberOfAyahs":3,"revelationType":"Meccan","juzStart":30,"ayahs":[{"numberInSurah":1,"globalNumber":6177,"arabicText":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَصْرِ","urduText":"عصر کی قسم","juz":30,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false},{"numberInSurah":2,"globalNumber":6178,"arabicText":"إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ","urduText":"کہ انسان نقصان میں ہے","juz":30,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false},{"numberInSurah":3,"globalNumber":6179,"arabicText":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ","urduText":"مگر وہ لوگ جو ایمان لائے اور نیک عمل کرتے رہے اور آپس میں حق (بات) کی تلقین اور صبر کی تاکید کرتے رہے","juz":30,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false}]}