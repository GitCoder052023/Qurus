{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Al-Kaafiroon","englishNameTranslation":"The Disbelievers","urduName":"کافرون / سورۃ الکافرون","numberOfAyahs":6,"revelationType":"Meccan","juzStart":30,"ayahs":[{"numberInSurah":1,"globalNumber":6208,"arabicText":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","urduText":"(اے پیغمبر ان منکران اسلام سے) کہہ دو کہ اے کافرو!","juz":30,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"numberInSurah":2,"globalNumber":6209,"arabicText":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","urduText":"جن (بتوں) کو تم پوچتے ہو ان کو میں نہیں پوجتا","juz":30,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"numberInSurah":3,"globalNumber":6210,"arabicText":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","urduText":"اور جس (خدا) کی میں عبادت کرتا ہوں اس کی تم عبادت نہیں کرتے","juz":30,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"numberInSurah":4,"globalNumber":6211,"arabicText":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","urduText":"اور (میں پھر کہتا ہوں کہ) جن کی تم پرستش کرتے ہوں ان کی میں پرستش کرنے والا نہیں ہوں","juz":30,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"numberInSurah":5,"globalNumber":6212,"arabicText":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","urduText":"اور نہ تم اس کی بندگی کرنے والے (معلوم ہوتے) ہو جس کی میں بندگی کرتا ہوں","juz":30,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"numberInSurah":6,"globalNumber":6213,"arabicText":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","urduText":"تم اپنے دین پر میں اپنے دین پر","juz":30,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false}]}