# Qurus PostHog Configuration
# Copy this file to .env or .env.local to configure your PostHog analytics credentials.
# Replace the placeholder values with your actual PostHog project API key and host.

# PostHog Project API Key (starts with phc_)
EXPO_PUBLIC_POSTHOG_API_KEY=phc_YOUR_POSTHOG_API_KEY_HERE

# PostHog Host (default is https://us.i.posthog.com or https://eu.i.posthog.com)
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
